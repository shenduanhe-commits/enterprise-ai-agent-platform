# =================================
# Application
# =================================

NODE_ENV=development


# =================================
# PostgreSQL
# =================================

POSTGRES_USER=eaap

POSTGRES_PASSWORD=eaap_password

POSTGRES_DB=eaap

POSTGRES_PORT=5432

DATABASE_URL=postgresql://eaap:eaap_password@localhost:5432/eaap



# =================================
# Redis
# =================================

REDIS_PORT=6379

REDIS_URL=redis://localhost:6379



# =================================
# Qdrant Vector Database
# =================================

QDRANT_PORT=6333

QDRANT_URL=http://localhost:6333



# =================================
# Backend API
# =================================

API_PORT=8000



# =================================
# Frontend
# =================================

WEB_PORT=5173

VITE_API_URL=http://localhost:8000



# =================================
# AI Providers
# =================================

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

QWEN_API_KEY=

QWEN_BASE_URL=

# 知识库向量（OpenAI 兼容协议）。不配 Key 或模型则本地 hash（64 维）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
# 每次请求 embedding API 的文本条数
EMBEDDING_BATCH=16
# 写入 Chat 的知识摘录粗估 token 上限（汉字约 1 token）
KNOWLEDGE_CONTEXT_TOKENS=1024

# Cross-encoder rerank（三者都配才启用；失败则特征 rerank）
# 百炼 qwen3.7-text-rerank 填原生 .../api/v1/services/rerank/text-rerank/text-rerank
# 不要抄 embedding 的 compatible-mode/v1。SiliconFlow 填到 /v1 即可
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=


# =================================
# JWT
# =================================

JWT_SECRET=change-me-to-a-long-random-string

JWT_EXPIRES_IN=15

JWT_REFRESH_EXPIRES_IN=7