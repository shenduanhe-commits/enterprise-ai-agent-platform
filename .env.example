# =================================
# Application
# =================================

NODE_ENV=development


# =================================
# PostgreSQL
# =================================

POSTGRES_USER=eaap

POSTGRES_PASSWORD=eaap_password

POSTGRES_DB=eaap

POSTGRES_PORT=5432

DATABASE_URL=postgresql://eaap:eaap_password@localhost:5432/eaap



# =================================
# Redis
# =================================

REDIS_PORT=6379

REDIS_URL=redis://localhost:6379



# =================================
# Qdrant Vector Database
# =================================

QDRANT_PORT=6333

QDRANT_URL=http://localhost:6333



# =================================
# Backend API
# =================================

API_PORT=8000



# =================================
# Frontend
# =================================

WEB_PORT=5173

VITE_API_URL=http://localhost:8000



# =================================
# AI Providers
# =================================

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

QWEN_API_KEY=

QWEN_BASE_URL=


# =================================
# JWT
# =================================

JWT_SECRET=change-me-to-a-long-random-string

JWT_EXPIRES_IN=15

JWT_REFRESH_EXPIRES_IN=7